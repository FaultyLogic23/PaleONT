    }, {
      "@id" : "https://w3id.org/paleont/Probable"
    }, {
      "@id" : "https://w3id.org/paleont/Tentative"
    } ]
  } ]
}, {
  "@id" : "_:genid30",
  "@type" : [ "http://www.w3.org/2002/07/owl#AllDifferent" ],
  "http://www.w3.org/2002/07/owl#distinctMembers" : [ {
    "@list" : [ {
      "@id" : "https://w3id.org/paleont/Discriminating"
    }, {
      "@id" : "https://w3id.org/paleont/Inconclusive"
    }, {
      "@id" : "https://w3id.org/paleont/Suggestive"
    } ]
  } ]
}, {
  "@id" : "_:genid34",
  "@type" : [ "http://www.w3.org/2002/07/owl#AllDifferent" ],
  "http://www.w3.org/2002/07/owl#distinctMembers" : [ {
    "@list" : [ {
      "@id" : "https://w3id.org/paleont/MedievalHumoral"
    }, {
      "@id" : "https://w3id.org/paleont/ModernBiomedical"
    } ]
  } ]
}, {
  "@id" : "_:genid9",
  "@type" : [ "http://www.w3.org/2002/07/owl#AllDisjointClasses" ],
  "http://www.w3.org/2002/07/owl#members" : [ {
    "@list" : [ {
      "@id" : "https://w3id.org/paleont/Bone"
    }, {
      "@id" : "https://w3id.org/paleont/CalibratedInterval"
    }, {
      "@id" : "https://w3id.org/paleont/Claim"
    }, {
      "@id" : "https://w3id.org/paleont/Condition"
    }, {
      "@id" : "https://w3id.org/paleont/ConfidenceLevel"
    }, {
