  <rdf:Description rdf:about="https://w3id.org/paleont/data/meth_archaeometry">
    <rdf:type rdf:resource="https://w3id.org/paleont/MethodologicalClaim"/>
    <rdfs:label xml:lang="en">Archaeometric analysis cannot establish the origin of the lesions</rdfs:label>
    <po:aboutTechnique rdf:resource="https://w3id.org/paleont/data/radiocarbon"/>
    <po:appliedTo rdf:resource="https://w3id.org/paleont/data/rf130"/>
    <po:appliedTo rdf:resource="https://w3id.org/paleont/data/sk90"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:discriminatesBetween rdf:resource="https://w3id.org/paleont/data/treponematosis"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:hasDiscriminatingPower rdf:resource="https://w3id.org/paleont/Inconclusive"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Certain"/>
    <po:hedgeWording>the results of the archaeometric analyses applied here cannot elucidate the origin of the probable treponemal bone lesions</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/epiphysealFusion">
    <rdf:type rdf:resource="https://w3id.org/paleont/Technique"/>
    <rdfs:label xml:lang="en">epiphyseal fusion and dental development assessment</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk94_obs_tibia">
    <rdf:type rdf:resource="https://w3id.org/paleont/Observation"/>
    <rdfs:label xml:lang="en">Bone changes of the right tibia fit Hackett's on-trial criteria of rugose nodes and expansions</rdfs:label>
