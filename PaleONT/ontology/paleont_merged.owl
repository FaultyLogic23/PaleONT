  <rdf:Description rdf:about="https://w3id.org/paleont/data/tp292_claim_treponematosis">
    <rdf:type rdf:resource="https://w3id.org/paleont/DiagnosticClaim"/>
    <rdfs:label xml:lang="en">Treponemal disease proposed for Tirup 292 on diagnostic, not on-trial, criteria</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/tp292"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
