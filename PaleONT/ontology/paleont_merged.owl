    <rdf:type rdf:resource="https://w3id.org/paleont/CalibratedInterval"/>
    <rdfs:label xml:lang="en">calAD 1435–1488, 95% CI, uncorrected for marine signature</rdfs:label>
    <po:confidenceInterval>95% CI, uncorrected for marine signature</po:confidenceInterval>
    <po:endYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1488</po:endYear>
    <po:startYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1435</po:startYear>
