  <rdf:Description rdf:about="https://w3id.org/paleont/data/adultAgeingError">
    <rdf:type rdf:resource="https://w3id.org/paleont/ErrorSource"/>
    <rdfs:label xml:lang="en">inaccuracy of adult age estimation</rdfs:label>
    <po:hasEffect>The adult skeleton changes little during life, so age is given with an inaccuracy of 10–20 years.</po:hasEffect>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/minAge">
