  <rdf:Description rdf:about="https://w3id.org/paleont/data/focalSuperficialCavitation">
    <rdf:type rdf:resource="https://w3id.org/paleont/LesionType"/>
    <rdfs:label xml:lang="en">focal superficial cavitation</rdfs:label>
    <rdfs:comment xml:lang="en">An on-trial criterion after Hackett (1976); the Discussion treats it as a diagnostic criterion for treponemal infection once tuberculosis is excluded.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/DiscriminatingPower">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Discriminating power</rdfs:label>
    <rdfs:comment xml:lang="en">How far a technique is said to separate competing
        hypotheses. A small controlled list, so that 'which techniques
        cannot discriminate' is a value filter rather than a second
        question.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/pelvicMorphology">
    <rdf:type rdf:resource="https://w3id.org/paleont/Technique"/>
