  <rdf:Description rdf:about="https://w3id.org/paleont/data/rf130_claim_alt_tuberculosis">
    <rdf:type rdf:resource="https://w3id.org/paleont/DiagnosticClaim"/>
    <rdfs:label xml:lang="en">Tuberculosis entertained as a differential diagnosis for Refshale 130</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/rf130"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Possible"/>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:proposesCondition rdf:resource="https://w3id.org/paleont/data/tuberculosis"/>
