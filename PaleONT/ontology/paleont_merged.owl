    <rdfs:label xml:lang="en">Leprosy entertained as a differential diagnosis for tp292</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/tp292"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Possible"/>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:proposesCondition rdf:resource="https://w3id.org/paleont/data/leprosy"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd73158e56c8645c78fd4c60d10d25949b11">
    <rdf:first rdf:resource="https://w3id.org/paleont/Observation"/>
    <rdf:rest rdf:nodeID="nd73158e56c8645c78fd4c60d10d25949b12"/>
  </rdf:Description>
