  <rdf:Description rdf:about="https://w3id.org/paleont/data/tp292_claim_noMercuryTreatment">
    <rdf:type rdf:resource="https://w3id.org/paleont/TreatmentClaim"/>
    <rdfs:label xml:lang="en">Treatment with Hg-containing medicine DENIED for Tirup 292</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/tp292"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/MedievalHumoral"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/tp292_obs_mercury"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Probable"/>
    <po:hedgeWording>these individuals were not exposed to high amounts of Hg during their life, but exhibit Hg concentrations typical for the non-exposed individuals</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:isNegated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</po:isNegated>
    <po:proposesTreatment rdf:resource="https://w3id.org/paleont/data/mercuryTreatment"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
