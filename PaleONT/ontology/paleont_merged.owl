  <rdf:Description rdf:about="https://w3id.org/paleont/CalibratedInterval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Calibrated interval</rdfs:label>
    <rdfs:comment xml:lang="en">A dated range with numeric bounds. A class rather than a
        literal because CQ4b must COMPUTE disagreement by comparing two
        intervals, which a label cannot support.</rdfs:comment>
  </rdf:Description>
