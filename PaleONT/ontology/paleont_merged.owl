  <rdf:Description rdf:about="https://w3id.org/paleont/data/tp292_obs_mercury">
    <rdf:type rdf:resource="https://w3id.org/paleont/Observation"/>
    <rdfs:label xml:lang="en">Hg concentration of 25 +/- 3 ng/g, within the 10 to 100 ng/g range normal for non-exposed medieval Danish individuals</rdfs:label>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:observedOn rdf:resource="https://w3id.org/paleont/data/tp292"/>
    <po:usedTechnique rdf:resource="https://w3id.org/paleont/data/cvaas"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/tp292_claim_age">
    <rdf:type rdf:resource="https://w3id.org/paleont/AgeClaim"/>
    <rdfs:label xml:lang="en">Age at death of Tirup 292 estimated at 20-24 years</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/tp292"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Probable"/>
    <po:hedgeWording>the individual from burial 292 from Tirup cemetery was most likely a female around 20-24 years</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:maxAge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</po:maxAge>
    <po:minAge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</po:minAge>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/rf130_reject_tuberculosis">
    <rdf:type rdf:resource="https://w3id.org/paleont/RejectionClaim"/>
    <rdfs:label xml:lang="en">Tuberculosis rejected for Refshale 130</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/rf130"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/rf130_obs_femur"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/rf130_obs_humerus"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Probable"/>
    <po:hedgeWording>tuberculosis is usually affecting the spine and the inner table of the cranium while hypertrophic expansion of the long bones is described as unusual</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:rejects rdf:resource="https://w3id.org/paleont/data/rf130_claim_alt_tuberculosis"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/Certain">
    <rdf:type rdf:resource="https://w3id.org/paleont/ConfidenceLevel"/>
    <rdfs:label xml:lang="en">certain</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd73158e56c8645c78fd4c60d10d25949b23">
    <rdf:first rdf:resource="https://w3id.org/paleont/Treatment"/>
    <rdf:rest rdf:nodeID="nd73158e56c8645c78fd4c60d10d25949b24"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/rf130_claim_date_armPosition">
    <rdf:type rdf:resource="https://w3id.org/paleont/DatingClaim"/>
    <rdfs:label xml:lang="en">Archaeological date of Refshale 130 by arm position</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/rf130"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/rf130_obs_armPosition"/>
    <po:hasResult rdf:resource="https://w3id.org/paleont/data/rf130_interval_armPosition"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Possible"/>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/rejects">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/paleont/engagesWith"/>
    <rdfs:label xml:lang="en">rejects</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/paleont/RejectionClaim"/>
    <rdfs:range rdf:resource="https://w3id.org/paleont/Claim"/>
    <rdfs:comment xml:lang="en">RANGE IS po:Claim, NOT po:Condition. This single line is
        the thesis expressed as an axiom: one rejects an assertion, not a
        disease. A rejection says nothing about whether the individual was
        ill.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/rf130_claim_systemic">
    <rdf:type rdf:resource="https://w3id.org/paleont/DiagnosticClaim"/>
    <rdfs:label xml:lang="en">A systemic disease proposed for Refshale 130</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/rf130"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/rf130_obs_femur"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/rf130_obs_fibula"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/rf130_obs_humerus"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/rf130_obs_radius"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/rf130_obs_tibia"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Probable"/>
    <po:hedgeWording>changes observed on nearly all the long bones indicate a systemic disease</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:proposesCondition rdf:resource="https://w3id.org/paleont/data/systemicDisease"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk89_obs_tibia">
    <rdf:type rdf:resource="https://w3id.org/paleont/Observation"/>
    <rdfs:label xml:lang="en">Both tibiae display nodes with striation on the medial side of the diaphysis; the surfaces appear very uneven and rugose, with bone deposits merging into the surrounding bone with diffuse borders</rdfs:label>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:observedOn rdf:resource="https://w3id.org/paleont/data/sk89"/>
    <po:observesLesionType rdf:resource="https://w3id.org/paleont/data/boneDeposits"/>
    <po:observesLesionType rdf:resource="https://w3id.org/paleont/data/nodesWithStriation"/>
    <po:onBone rdf:resource="https://w3id.org/paleont/data/tibia"/>
    <po:usedTechnique rdf:resource="https://w3id.org/paleont/data/macroscopic"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd73158e56c8645c78fd4c60d10d25949b20">
    <rdf:first rdf:resource="https://w3id.org/paleont/Source"/>
    <rdf:rest rdf:nodeID="nd73158e56c8645c78fd4c60d10d25949b21"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">PaleONT — an ontology of palaeopathological claims</dcterms:title>
    <dcterms:description xml:lang="en">Models the epistemic structure of palaeopathological
        reporting: observations, the claims grounded in them, the frameworks
        under which those claims are made, and the adjudication between
        competing claims.</dcterms:description>
    <owl:versionInfo>0.1.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/marineCorrection">
    <rdf:type rdf:resource="https://w3id.org/paleont/Correction"/>
    <rdfs:label xml:lang="en">marine reservoir correction</rdfs:label>
    <rdfs:comment xml:lang="en">K_reservoir = 410 * (19.8 + δ13C_sample) / 8.9 14C-years (Rasmussen et al. 2008). The magnitude depends on the estimated marine diet: 4 years for Sk. 90 (1% marine), 45 years for Refshale 130 (13% marine).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/AgeClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/paleont/Claim"/>
    <rdfs:label xml:lang="en">Age claim</rdfs:label>
    <rdfs:comment xml:lang="en">Proposes an age-at-death range. Age is a claim, not a
        property of the specimen — deliberately the same shape as a
        diagnosis.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/venerealSyphilis">
    <rdf:type rdf:resource="https://w3id.org/paleont/Condition"/>
    <rdfs:label xml:lang="en">venereal syphilis (Treponema pallidum pallidum)</rdfs:label>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005976"/>
    <rdfs:comment xml:lang="en">⚠ closeMatch until checked: MONDO:0005976 is 'Syphilis'; the paper's term is specifically VENEREAL syphilis, opposed throughout to the non-venereal treponematoses.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk89_claim_treponematosis">
    <rdf:type rdf:resource="https://w3id.org/paleont/DiagnosticClaim"/>
    <rdfs:label xml:lang="en">Treponemal disease entertained for Sk. 89, below the confidence granted to Sk. 90</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/sk89"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk89_obs_tibia"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk89_obs_tibia_cavitation"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk89_obs_tibia_ct"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Possible"/>
    <po:hedgeWording>lesions consistent with treponemal disease are found on several long bones, but only those in skeleton 90 from St. Albani are indicative of treponemal infection</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:proposesCondition rdf:resource="https://w3id.org/paleont/data/treponematosis"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/boldsen2007">
    <rdf:type rdf:resource="https://w3id.org/paleont/Source"/>
    <rdfs:label xml:lang="en">Boldsen 2007, Leprosy in medieval Denmark: a comprehensive analysis</rdfs:label>
  </rdf:Description>
