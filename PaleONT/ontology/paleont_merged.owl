  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk90_claim_date_c14">
    <rdf:type rdf:resource="https://w3id.org/paleont/DatingClaim"/>
    <rdfs:label xml:lang="en">Radiocarbon date of Sk. 90, marine-corrected</rdfs:label>
    <cito:updates rdf:resource="https://w3id.org/paleont/data/sk90_claim_date_armPosition"/>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/sk90"/>
    <po:appliedCorrection rdf:resource="https://w3id.org/paleont/data/marineCorrection"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk90_obs_isotopes"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk90_obs_radiocarbon"/>
    <po:hasResult rdf:resource="https://w3id.org/paleont/data/sk90_interval_c14_corrected"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Certain"/>
    <po:hedgeWording>the radiocarbon age for this individual can be considered to be completely reliable</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk90_claim_treponematosis">
    <rdf:type rdf:resource="https://w3id.org/paleont/DiagnosticClaim"/>
    <rdfs:label xml:lang="en">Treponemal infection proposed for Sk. 90</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/sk90"/>
