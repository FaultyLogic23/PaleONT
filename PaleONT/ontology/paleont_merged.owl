    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/tp292_obs_frontal"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/tp292_obs_frontal_ct"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/tp292_obs_nasal"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Probable"/>
    <po:hedgeWording>the changes on the frontal as well as the nasal bones are regarded as diagnostic for treponemal disease</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:proposesCondition rdf:resource="https://w3id.org/paleont/data/treponematosis"/>
