  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk89_obs_isotopes">
    <rdf:type rdf:resource="https://w3id.org/paleont/Observation"/>
    <rdfs:label xml:lang="en">delta13C -18.64 per mil, delta15N 12.53 per mil, C:N 3.4, estimated marine diet 13 per cent</rdfs:label>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:observedOn rdf:resource="https://w3id.org/paleont/data/sk89"/>
