  <rdf:Description rdf:about="https://w3id.org/paleont/data/hackett1976">
    <rdf:type rdf:resource="https://w3id.org/paleont/Source"/>
    <rdfs:label xml:lang="en">Hackett 1976, Diagnostic criteria of syphilis, yaws and treponarid</rdfs:label>
    <rdfs:comment xml:lang="en">The source of the on-trial and diagnostic criteria the study scores its lesions against.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/freshwaterReservoir">
    <rdf:type rdf:resource="https://w3id.org/paleont/ErrorSource"/>
    <rdfs:label xml:lang="en">freshwater reservoir effect</rdfs:label>
    <po:hasEffect>The intake of freshwater fish protein can make radiocarbon ages appear as much as 100 to 1000 years too old; no reliable correction can presently be calculated for it.</po:hasEffect>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/meth_mercury">
    <rdf:type rdf:resource="https://w3id.org/paleont/MethodologicalClaim"/>
    <rdfs:label xml:lang="en">Mercury analysis is a helpful but not decisive tool</rdfs:label>
    <po:aboutTechnique rdf:resource="https://w3id.org/paleont/data/cvaas"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:hasDiscriminatingPower rdf:resource="https://w3id.org/paleont/Suggestive"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Probable"/>
    <po:hedgeWording>the Hg analysis is found to be a helpful tool when analysing skeletal remains from the medieval times for pathologies</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/ConfidenceLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Confidence level</rdfs:label>
    <rdfs:comment xml:lang="en">The hedge attached to a claim, as an individual rather
        than a string or a number. A number would invent precision the source
        never produced; a string cannot be counted, grouped or ordered.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/rf130_obs_tibia">
    <rdf:type rdf:resource="https://w3id.org/paleont/Observation"/>
    <rdfs:label xml:lang="en">Tibiae: multiple channelled vascular impressions posteriorly; periostitis and linear striations dominating the anterior and medial diaphysis; shaft slightly bowed anteriorly</rdfs:label>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:observedOn rdf:resource="https://w3id.org/paleont/data/rf130"/>
    <po:observesLesionType rdf:resource="https://w3id.org/paleont/data/linearStriation"/>
    <po:observesLesionType rdf:resource="https://w3id.org/paleont/data/periostealReaction"/>
    <po:onBone rdf:resource="https://w3id.org/paleont/data/tibia"/>
    <po:usedTechnique rdf:resource="https://w3id.org/paleont/data/macroscopic"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/RejectionClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/paleont/Claim"/>
    <rdfs:label xml:lang="en">Rejection claim</rdfs:label>
    <rdfs:comment xml:lang="en">Rejects another claim. Note the range of po:rejects: a
        rejection is an act against an ASSERTION, never a verdict on the
        truth of a disease. Acquittal is not innocence.</rdfs:comment>
  </rdf:Description>
