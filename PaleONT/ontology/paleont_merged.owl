  <rdf:Description rdf:about="https://w3id.org/paleont/Correction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Correction</rdfs:label>
    <rdfs:comment xml:lang="en">An adjustment applied to one particular dating. A property
        of THIS dating: it holds here. Recording it is what turns an apparent
        contradiction between two dates into two declared treatments of one
        measurement — and prevents CQ4b from reporting false positives.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk90_reject_pagets">
    <rdf:type rdf:resource="https://w3id.org/paleont/RejectionClaim"/>
