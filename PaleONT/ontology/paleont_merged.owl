  <rdf:Description rdf:about="https://w3id.org/paleont/Technique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Technique</rdfs:label>
    <rdfs:comment xml:lang="en">Any means by which an observation is produced: naked-eye
        examination, radiography, radiocarbon dating, atomic absorption
        spectrometry. ONE class, no hierarchy. Ranking techniques by
        reliability is what the sources ARGUE about, so it must live in
        po:MethodologicalClaim, never in the schema.</rdfs:comment>
  </rdf:Description>
