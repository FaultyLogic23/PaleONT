    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/rf130_obs_femur"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/rf130_obs_tibia"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Possible"/>
    <po:hedgeWording>lesions consistent with treponemal disease are found on several long bones, but only those in skeleton 90 from St. Albani are indicative of treponemal infection</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:proposesCondition rdf:resource="https://w3id.org/paleont/data/treponematosis"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/TreatmentClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/paleont/Claim"/>
    <rdfs:label xml:lang="en">Treatment claim</rdfs:label>
    <rdfs:comment xml:lang="en">Proposes a treatment received in life. Typically made
        under a historical framework, and typically grounded in a chemical
        observation such as mercury.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/proposesCondition">
