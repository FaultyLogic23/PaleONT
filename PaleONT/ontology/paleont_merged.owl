  <rdf:Description rdf:about="https://w3id.org/paleont/data/irms">
    <rdf:type rdf:resource="https://w3id.org/paleont/Technique"/>
    <rdfs:label xml:lang="en">isotope-ratio mass spectrometry (IRMS)</rdfs:label>
    <rdfs:comment xml:lang="en">δ13C and δ15N on bone collagen, Museum für Naturkunde, Berlin.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/declaredIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">declared in</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/paleont/Source"/>
    <rdfs:comment xml:lang="en">NO rdfs:domain, deliberately. Observations are published in
        a source just as claims are, and an observation is not a claim — the
        two classes are disjoint. Declaring the domain as po:Claim made every
        observation carrying this property inferred to be a Claim, and the
        ontology inconsistent. HermiT caught it. Either the domain goes, or a
        union class is introduced; the union buys nothing here, so it goes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/tp292">
    <rdf:type rdf:resource="https://w3id.org/paleont/Specimen"/>
    <rdfs:label xml:lang="en">Tirup, Skeleton 292</rdfs:label>
    <rdfs:comment xml:lang="en">Burial 292, Tirup cemetery, near Horsens (Jutland). Rural site. Female, early adult. One of only 79 individuals examined at Tirup and the only one selected for this study.</rdfs:comment>
    <po:specimenID>Tirup-292</po:specimenID>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk90_obs_femur">
