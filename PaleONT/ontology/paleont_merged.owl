  <rdf:Description rdf:about="https://w3id.org/paleont/data/rf130_claim_treponematosis">
    <rdf:type rdf:resource="https://w3id.org/paleont/DiagnosticClaim"/>
    <rdfs:label xml:lang="en">Treponemal disease entertained for Refshale 130, at a lower confidence than Sk. 90</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/rf130"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
