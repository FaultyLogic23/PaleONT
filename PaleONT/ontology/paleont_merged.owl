    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has discriminating power</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/paleont/MethodologicalClaim"/>
    <rdfs:range rdf:resource="https://w3id.org/paleont/DiscriminatingPower"/>
  </rdf:Description>
