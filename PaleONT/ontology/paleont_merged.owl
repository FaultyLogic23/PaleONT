  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk90_obs_radiocarbon">
    <rdf:type rdf:resource="https://w3id.org/paleont/Observation"/>
    <rdfs:label xml:lang="en">Uncalibrated radiocarbon age 420 ± 20 BP on bone collagen</rdfs:label>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:observedOn rdf:resource="https://w3id.org/paleont/data/sk90"/>
    <po:usedTechnique rdf:resource="https://w3id.org/paleont/data/radiocarbon"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/marineReservoir">
    <rdf:type rdf:resource="https://w3id.org/paleont/ErrorSource"/>
    <rdfs:label xml:lang="en">marine reservoir effect</rdfs:label>
    <po:hasEffect>Skeletal remains of individuals consuming a diet rich in marine proteins give radiocarbon dates that appear older than they actually are. The reservoir age for open waters in the North Atlantic and the open inner Danish waters is around 410 years.</po:hasEffect>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/rf130_obs_radiocarbon">
    <rdf:type rdf:resource="https://w3id.org/paleont/Observation"/>
    <rdfs:label xml:lang="en">Uncalibrated radiocarbon age 925 ± 25 BP; corrected 870 ± 25 BP</rdfs:label>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:observedOn rdf:resource="https://w3id.org/paleont/data/rf130"/>
    <po:usedTechnique rdf:resource="https://w3id.org/paleont/data/radiocarbon"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/MethodologicalClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/paleont/Claim"/>
    <rdfs:subClassOf rdf:nodeID="nd73158e56c8645c78fd4c60d10d25949b1"/>
    <rdfs:label xml:lang="en">Methodological claim</rdfs:label>
    <rdfs:comment xml:lang="en">A claim about what a technique can or cannot establish.
        The meta level. Note that it has NO po:aboutSpecimen: its subject
        matter is a technique, not a skeleton. That absence is how the model
        distinguishes 'this individual had leprosy' from 'this method cannot
        tell leprosy from syphilis'.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk94_obs_tibia_ct">
    <rdf:type rdf:resource="https://w3id.org/paleont/Observation"/>
    <rdfs:label xml:lang="en">CT: thickened diaphysis with several osteolytic foci in the cortical bone, destruction of the cortical structure and bone expansions; increased signal intensity in the remaining compact bone, consistent with inflammatory involvement</rdfs:label>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:observedOn rdf:resource="https://w3id.org/paleont/data/sk94"/>
    <po:observesLesionType rdf:resource="https://w3id.org/paleont/data/osteolyticLesion"/>
    <po:observesLesionType rdf:resource="https://w3id.org/paleont/data/periostealReaction"/>
    <po:onBone rdf:resource="https://w3id.org/paleont/data/tibia"/>
    <po:usedTechnique rdf:resource="https://w3id.org/paleont/data/ct"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk94_claim_treponematosis">
