  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk90_interval_c14_corrected">
    <rdf:type rdf:resource="https://w3id.org/paleont/CalibratedInterval"/>
    <rdfs:label xml:lang="en">calAD 1443–1466 at 1 sigma</rdfs:label>
    <po:confidenceInterval>1 sigma</po:confidenceInterval>
    <po:endYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1466</po:endYear>
    <po:startYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1443</po:startYear>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/underFramework">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">under framework</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/paleont/Claim"/>
    <rdfs:range rdf:resource="https://w3id.org/paleont/DiagnosticFramework"/>
    <rdfs:comment xml:lang="en">The standpoint FROM WHICH the claim is made — the frame the
        claimant occupies. Functional: a claim is made from one position. Two
        positions on the same content are two claims.
        For a single modern source every claim is ModernBiomedical, and that
        uniformity is a finding, not a defect: the paper never leaves the
        modern frame. What varies is po:framesContent.</rdfs:comment>
  </rdf:Description>
