    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk90_obs_femur"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk90_obs_humerus"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk90_obs_parietal"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk90_obs_parietal_ct"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk90_obs_tibia"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Probable"/>
