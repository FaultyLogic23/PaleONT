    <rdfs:label xml:lang="en">tentative</rdfs:label>
    <po:weakerThan rdf:resource="https://w3id.org/paleont/Possible"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk90_obs_tibia">
