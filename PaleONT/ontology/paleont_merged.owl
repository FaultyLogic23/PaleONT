    <rdfs:label xml:lang="en">Burial arm position A recorded, placing the burial between AD 1100 and 1250</rdfs:label>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:observedOn rdf:resource="https://w3id.org/paleont/data/tp292"/>
