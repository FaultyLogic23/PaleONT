    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/sk94"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk94_obs_femur_ct"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk94_obs_tibia"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk94_obs_tibia_ct"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Possible"/>
    <po:hedgeWording>the documented lesions of three of them only meet the descriptions of Hackett's on-trial criteria</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:proposesCondition rdf:resource="https://w3id.org/paleont/data/treponematosis"/>
