  <rdf:Description rdf:about="https://w3id.org/paleont/Specimen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Specimen</rdfs:label>
    <rdfs:comment xml:lang="en">A set of skeletal remains attributed to one individual.
        The anchor of the graph. Deliberately poor in properties: almost
        nothing is said ABOUT a specimen, because almost everything one might
        want to say is in fact a claim someone made.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/meth_ct">
    <rdf:type rdf:resource="https://w3id.org/paleont/MethodologicalClaim"/>
    <rdfs:label xml:lang="en">CT cannot separate the causative agents of treponemal infection</rdfs:label>
    <po:aboutTechnique rdf:resource="https://w3id.org/paleont/data/ct"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:discriminatesBetween rdf:resource="https://w3id.org/paleont/data/treponematosis"/>
    <po:discriminatesBetween rdf:resource="https://w3id.org/paleont/data/venerealSyphilis"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:hasDiscriminatingPower rdf:resource="https://w3id.org/paleont/Inconclusive"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Certain"/>
    <po:hedgeWording>neither X-ray nor CT-scanning can distinguish between the different causative agents of treponemal infection</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
