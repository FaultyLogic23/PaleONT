  <rdf:Description rdf:about="https://w3id.org/paleont/data/countingUncertainty">
    <rdf:type rdf:resource="https://w3id.org/paleont/ErrorSource"/>
    <rdfs:label xml:lang="en">statistical uncertainty of the calibrated age interval</rdfs:label>
    <po:hasEffect>The precision of the radiocarbon dates of medieval samples is often better than ±25 to 30 years for the 1 sigma statistical uncertainty of the calibrated age interval; reservoir effects, where present, introduce an offset and an added uncertainty.</po:hasEffect>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd73158e56c8645c78fd4c60d10d25949b33">
    <rdf:first rdf:resource="https://w3id.org/paleont/Inconclusive"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/tp292_interval_armPosition">
    <rdf:type rdf:resource="https://w3id.org/paleont/CalibratedInterval"/>
    <rdfs:label xml:lang="en">AD 1100-1250 (archaeological, arm position A)</rdfs:label>
    <po:confidenceInterval>archaeological, no statistical confidence stated</po:confidenceInterval>
    <po:endYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1250</po:endYear>
    <po:startYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1100</po:startYear>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk89_obs_tibia_cavitation">
    <rdf:type rdf:resource="https://w3id.org/paleont/Observation"/>
    <rdfs:label xml:lang="en">One of the nodes on the right tibia shows superficial cavitation, a diagnostic criterion after Hackett</rdfs:label>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:observedOn rdf:resource="https://w3id.org/paleont/data/sk89"/>
    <po:observesLesionType rdf:resource="https://w3id.org/paleont/data/focalSuperficialCavitation"/>
    <po:onBone rdf:resource="https://w3id.org/paleont/data/tibia"/>
    <po:usedTechnique rdf:resource="https://w3id.org/paleont/data/macroscopic"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk90_claim_alt_tuberculosis">
    <rdf:type rdf:resource="https://w3id.org/paleont/DiagnosticClaim"/>
    <rdfs:label xml:lang="en">Tuberculosis entertained as a differential diagnosis</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/sk90"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Possible"/>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:proposesCondition rdf:resource="https://w3id.org/paleont/data/tuberculosis"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd73158e56c8645c78fd4c60d10d25949b7">
    <rdf:first rdf:resource="https://w3id.org/paleont/TreatmentClaim"/>
    <rdf:rest rdf:nodeID="nd73158e56c8645c78fd4c60d10d25949b8"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/meth_armPosition">
    <rdf:type rdf:resource="https://w3id.org/paleont/MethodologicalClaim"/>
    <rdfs:label xml:lang="en">Arm-position dating is not substantiated by scientific dating methods</rdfs:label>
    <po:aboutTechnique rdf:resource="https://w3id.org/paleont/data/armPosition"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:hasDiscriminatingPower rdf:resource="https://w3id.org/paleont/Suggestive"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Probable"/>
    <po:hedgeWording>the arm position methodology has not been substantiated by scientific dating methods such as radiocarbon dating, dendrochronology or thermoluminescence</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/proposes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">proposes</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/paleont/Claim"/>
    <rdfs:comment xml:lang="en">Superproperty. Never asserted directly; always inferred.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/groundedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">grounded in</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/paleont/Claim"/>
    <rdfs:range rdf:resource="https://w3id.org/paleont/Observation"/>
    <rdfs:comment xml:lang="en">THE boundary property. Everything on the left is evidence,
        everything on the right is interpretation. Not functional: one claim
        may rest on several observations. See decision D1 on whether the
        range should widen to include po:Claim.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk89_claim_mercuryTreatment">
    <rdf:type rdf:resource="https://w3id.org/paleont/TreatmentClaim"/>
    <rdfs:label xml:lang="en">Treatment with Hg-containing medicine proposed for Sk. 89</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/sk89"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/MedievalHumoral"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk89_obs_mercury"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Probable"/>
    <po:hedgeWording>they have apparently been treated with Hg-containing medicine</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:proposesTreatment rdf:resource="https://w3id.org/paleont/data/mercuryTreatment"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk89_obs_tibia_ct">
    <rdf:type rdf:resource="https://w3id.org/paleont/Observation"/>
    <rdfs:label xml:lang="en">CT: an osteolytic lesion in the new bone on the anterior part of the right tibia, with very low density of the original bone; periosteal reactions on the anteriorly bowed cortex</rdfs:label>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:observedOn rdf:resource="https://w3id.org/paleont/data/sk89"/>
    <po:observesLesionType rdf:resource="https://w3id.org/paleont/data/osteolyticLesion"/>
    <po:observesLesionType rdf:resource="https://w3id.org/paleont/data/periostealReaction"/>
    <po:onBone rdf:resource="https://w3id.org/paleont/data/tibia"/>
    <po:usedTechnique rdf:resource="https://w3id.org/paleont/data/ct"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/heldBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">held by</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/paleont/Claim"/>
