  <rdf:Description rdf:about="https://w3id.org/paleont/data/rf130_claim_age">
    <rdf:type rdf:resource="https://w3id.org/paleont/AgeClaim"/>
    <rdfs:label xml:lang="en">Age at death of Refshale 130 estimated at 24.7–46.4 years</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/rf130"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/rf130_obs_transition"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Probable"/>
    <po:hedgeWording>transition analysis suggests an age between 24.7 to 46.4 years with a maximum likelihood of 32.9 years</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:maxAge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">46</po:maxAge>
    <po:minAge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</po:minAge>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/Claim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Claim</rdfs:label>
    <rdfs:comment xml:lang="en">A proposition held by an agent, under a framework, with a
        stated degree of confidence, grounded in one or more observations.
        Nothing enters this graph as fact; everything enters as something
        someone asserted.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk90_reject_venereal">
    <rdf:type rdf:resource="https://w3id.org/paleont/RejectionClaim"/>
    <rdfs:label xml:lang="en">Pre-Columbian venereal syphilis rejected</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/sk90"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk90_obs_parietal"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk90_obs_tibia"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Probable"/>
    <po:hedgeWording>the hypothesis that pre-Columbian venereal syphilis existed among the analysed skeletal material is rejected with the help of various archaeometric analyses</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:rejects rdf:resource="https://w3id.org/paleont/data/sk90_claim_alt_venereal"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
