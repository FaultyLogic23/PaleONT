  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk90_reject_fungal">
    <rdf:type rdf:resource="https://w3id.org/paleont/RejectionClaim"/>
    <rdfs:label xml:lang="en">Fungal infection rejected</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/sk90"/>
