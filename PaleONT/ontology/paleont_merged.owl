  <rdf:Description rdf:about="https://w3id.org/paleont/data/tp292_claim_alt_yaws">
    <rdf:type rdf:resource="https://w3id.org/paleont/DiagnosticClaim"/>
    <rdfs:label xml:lang="en">Yaws left open as an alternative for Tirup 292, entertained and never rejected</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/tp292"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/tp292_obs_frontal"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Possible"/>
    <po:hedgeWording>these changes are regarded as diagnostic for treponemal disease, but can also occur in bejel and yaws</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:proposesCondition rdf:resource="https://w3id.org/paleont/data/yaws"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/rf130_claim_accordance">
    <rdf:type rdf:resource="https://w3id.org/paleont/MethodologicalClaim"/>
    <rdfs:label xml:lang="en">The paper claims complete accordance between the two dates for Refshale 130</rdfs:label>
    <po:aboutTechnique rdf:resource="https://w3id.org/paleont/data/radiocarbon"/>
    <po:appliedTo rdf:resource="https://w3id.org/paleont/data/rf130"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:hasDiscriminatingPower rdf:resource="https://w3id.org/paleont/Suggestive"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Probable"/>
    <po:hedgeWording>only in the case of burial 130 from Refshale is seen a complete accordance</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/observedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">observed on</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/paleont/Observation"/>
    <rdfs:range rdf:resource="https://w3id.org/paleont/Specimen"/>
    <rdfs:comment xml:lang="en">Functional: one observation concerns one specimen.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/hasErrorSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has error source</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/paleont/Technique"/>
    <rdfs:range rdf:resource="https://w3id.org/paleont/ErrorSource"/>
    <rdfs:comment xml:lang="en">Domain is the technique: a known limitation holds always.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk90_reject_osteomyelitis">
    <rdf:type rdf:resource="https://w3id.org/paleont/RejectionClaim"/>
    <rdfs:label xml:lang="en">Pyogenic osteomyelitis rejected</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/sk90"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk90_obs_femur"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk90_obs_humerus"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk90_obs_tibia"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Probable"/>
    <po:hedgeWording>changes caused by pyogenic osteomyelitis are characterized by cloacae and sequestrate, but usually do not involve multiple skeletal elements</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:rejects rdf:resource="https://w3id.org/paleont/data/sk90_claim_alt_osteomyelitis"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/serpiginousCavitation">
    <rdf:type rdf:resource="https://w3id.org/paleont/LesionType"/>
    <rdfs:label xml:lang="en">serpiginous cavitation</rdfs:label>
    <rdfs:comment xml:lang="en">Regarded by the source as diagnostic for treponemal disease (Hackett p. 45), while noting that it also occurs in bejel and yaws.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/discriminatesBetween">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">discriminates between</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/paleont/MethodologicalClaim"/>
    <rdfs:range rdf:resource="https://w3id.org/paleont/Condition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk94_claim_age">
    <rdf:type rdf:resource="https://w3id.org/paleont/AgeClaim"/>
    <rdfs:label xml:lang="en">Age at death of Sk. 94 estimated at 35-45 years</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/sk94"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk94_obs_pubicSymphysis"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Probable"/>
    <po:hedgeWording>the changes on the pubic symphysis as well as on the auricular surface are consistent with an individual who was 35-45 years old when he died</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:maxAge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">45</po:maxAge>
    <po:minAge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</po:minAge>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk89_claim_age">
    <rdf:type rdf:resource="https://w3id.org/paleont/AgeClaim"/>
    <rdfs:label xml:lang="en">Age at death of Sk. 89 given only as adult; the bounds recorded here are the study's adult category, not a measured estimate</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/sk89"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/sk89_obs_tibia"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Tentative"/>
    <po:hedgeWording>only the postcranial skeleton is present, which made ageing and sexing the individual difficult</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:maxAge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</po:maxAge>
    <po:minAge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</po:minAge>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/hedgeWording">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">hedge wording</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/paleont/Claim"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The source's EXACT words — 'cannot be excluded',
        'consistent with'. po:hedge gives the normalised level for querying;
        this keeps the original phrasing, so that our normalisation never
        silently replaces the author's own hedging.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/tp292_claim_preColumbian">
    <rdf:type rdf:resource="https://w3id.org/paleont/DiagnosticClaim"/>
    <rdfs:label xml:lang="en">Tirup 292 asserted as a securely pre-Columbian case of treponemal infection</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/tp292"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:groundedIn rdf:resource="https://w3id.org/paleont/data/tp292_obs_armPosition"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Certain"/>
    <po:hedgeWording>the results of our analyses show that those two, Tirup 292 and St. Albani 90, can be securely dated to pre-Columbian times</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/schwarzTeam"/>
    <po:proposesCondition rdf:resource="https://w3id.org/paleont/data/treponematosis"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
