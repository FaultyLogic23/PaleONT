    <rdfs:label xml:lang="en">CT: increased density of the diploë, thickening of the tables, outer table interrupted by round notches, focal radiolucent areas</rdfs:label>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:observedOn rdf:resource="https://w3id.org/paleont/data/sk90"/>
