    <po:observedOn rdf:resource="https://w3id.org/paleont/data/sk94"/>
    <po:observesLesionType rdf:resource="https://w3id.org/paleont/data/nodesWithStriation"/>
    <po:observesLesionType rdf:resource="https://w3id.org/paleont/data/rugoseExpansion"/>
    <po:onBone rdf:resource="https://w3id.org/paleont/data/tibia"/>
    <po:usedTechnique rdf:resource="https://w3id.org/paleont/data/macroscopic"/>
