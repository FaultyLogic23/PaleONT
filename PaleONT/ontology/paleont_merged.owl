  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk89_obs_radiocarbon">
    <rdf:type rdf:resource="https://w3id.org/paleont/Observation"/>
    <rdfs:label xml:lang="en">Uncalibrated radiocarbon age 490 +/- 25 BP; corrected for the marine component, 437 +/- 20 BP</rdfs:label>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/schwarz2013"/>
    <po:observedOn rdf:resource="https://w3id.org/paleont/data/sk89"/>
    <po:usedTechnique rdf:resource="https://w3id.org/paleont/data/radiocarbon"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/usedTechnique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">used technique</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/paleont/Observation"/>
    <rdfs:range rdf:resource="https://w3id.org/paleont/Technique"/>
    <rdfs:comment xml:lang="en">Domain is Observation, not Claim. A dating claim therefore
        reaches its technique through groundedIn/usedTechnique. This enforces
        that every use of a technique is an observation — see decision D2.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/tp292_claim_alt_leprosy">
