    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Observation</rdfs:label>
    <rdfs:comment xml:lang="en">One act of examining a specimen with a technique, yielding
        one datum. Carries what was seen, on which bone, by which technique.
        This is the concrete occurrence: the lesion TYPE is shared across
        specimens, the observation is not.</rdfs:comment>
  </rdf:Description>
