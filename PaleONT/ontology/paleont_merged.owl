  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/nodesWithStriation">
    <rdf:type rdf:resource="https://w3id.org/paleont/LesionType"/>
    <rdfs:label xml:lang="en">nodes with striation</rdfs:label>
    <rdfs:comment xml:lang="en">An on-trial criterion after Hackett (1976), p. 78.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/data/sk90_claim_ortner">
    <rdf:type rdf:resource="https://w3id.org/paleont/DiagnosticClaim"/>
    <rdfs:label xml:lang="en">Ortner: pre-1500 Old World syphilis remains contentious</rdfs:label>
    <po:aboutSpecimen rdf:resource="https://w3id.org/paleont/data/sk90"/>
    <po:declaredIn rdf:resource="https://w3id.org/paleont/data/ortner2011"/>
    <po:framesContent rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
    <po:hedge rdf:resource="https://w3id.org/paleont/Tentative"/>
    <po:hedgeWording>the presence of syphilis in the Old World before 1500 A.D. remains a very contentious issue</po:hedgeWording>
    <po:heldBy rdf:resource="https://w3id.org/paleont/data/ortner"/>
    <po:underFramework rdf:resource="https://w3id.org/paleont/ModernBiomedical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/paleont/Tentative">
