ex:fibula a po:Bone ;
    rdfs:label "fibula"@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/UBERON_0001446> .

ex:freshwaterReservoir a po:ErrorSource ;
    rdfs:label "freshwater reservoir effect"@en ;
    po:hasEffect "The intake of freshwater fish protein can make radiocarbon ages appear as much as 100 to 1000 years too old; no reliable correction can presently be calculated for it." .

ex:fungalInfection a po:Condition ;
    rdfs:label "fungal infection"@en .

ex:harper a foaf:Person ;
    foaf:name "Kristin N. Harper" .

ex:harper2008 a po:Source ;
    rdfs:label "Harper et al. 2008, PLoS Negl Trop Dis 2(1):e148"@en .

ex:marineReservoir a po:ErrorSource ;
    rdfs:label "marine reservoir effect"@en ;
    po:hasEffect "Skeletal remains of individuals consuming a diet rich in marine proteins give radiocarbon dates that appear older than they actually are. The reservoir age for open waters in the North Atlantic and the open inner Danish waters is around 410 years." .

ex:nasalAperture a po:Bone ;
    rdfs:label "nasal aperture"@en .

ex:ortner a foaf:Person ;
    foaf:name "Donald J. Ortner" .

ex:ortner2011 a po:Source ;
    rdfs:label "Ortner 2011, Virchows Arch 459:247–254"@en .

ex:pagetsDisease a po:Condition ;
    rdfs:label "Paget's disease of bone (osteitis deformans)"@en ;
    rdfs:comment "⚠ closeMatch until checked: 'Paget's disease' is ambiguous between the bone disease and Paget disease of the breast. The paper means the skeletal one."@en ;
    skos:closeMatch <http://purl.obolibrary.org/obo/MONDO_0005382> .

ex:pyogenicOsteomyelitis a po:Condition ;
    rdfs:label "pyogenic osteomyelitis"@en .

ex:radius a po:Bone ;
    rdfs:label "radius"@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/UBERON_0001423> .

ex:rf130_claim_alt_leprosy a po:DiagnosticClaim ;
    rdfs:label "Leprosy entertained as a differential diagnosis for Refshale 130"@en ;
