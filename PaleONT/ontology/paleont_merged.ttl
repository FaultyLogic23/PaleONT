@prefix cito: <http://purl.org/spar/cito/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://w3id.org/paleont/data/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix po: <https://w3id.org/paleont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cito:agreesWith rdfs:subPropertyOf po:engagesWith .

cito:disagreesWith rdfs:subPropertyOf po:engagesWith .

cito:updates rdfs:subPropertyOf po:engagesWith .

po: a owl:Ontology ;
    dcterms:description """Models the epistemic structure of palaeopathological
        reporting: observations, the claims grounded in them, the frameworks
        under which those claims are made, and the adjudication between
        competing claims."""@en ;
    dcterms:title "PaleONT — an ontology of palaeopathological claims"@en ;
    owl:versionInfo "0.1.0" .

po:aboutTechnique a owl:ObjectProperty ;
    rdfs:label "about technique"@en ;
    rdfs:domain po:MethodologicalClaim ;
    rdfs:range po:Technique .

po:appliedCorrection a owl:ObjectProperty ;
    rdfs:label "applied correction"@en ;
    rdfs:domain po:DatingClaim ;
    rdfs:range po:Correction .

po:appliedTo a owl:ObjectProperty ;
    rdfs:label "applied to"@en ;
    rdfs:comment """Decision D5. A methodological claim may NOT have
        po:aboutSpecimen — the restriction above forbids it, because its
        subject matter is a technique, not a skeleton. But a judgement about a
        method is often reached in the course of examining particular
        specimens, and the source says so: "the results of the archaeometric
        analyses APPLIED HERE cannot elucidate the origin".

        po:appliedTo records that occasion without claiming the judgement is
        about the skeleton. "CT cannot separate the treponematoses" remains a
        statement about CT; po:appliedTo says where that was found out.

        Same shape of problem as D4, same shape of solution: when one property
        is being asked to mean two things, split it rather than equivocate or
        forbid."""@en ;
    rdfs:domain po:MethodologicalClaim ;
    rdfs:range po:Specimen .

po:confidenceInterval a owl:DatatypeProperty ;
    rdfs:label "confidence interval"@en ;
    rdfs:comment """The statistical confidence at which the bounds are stated:
        "1 sigma", "95% CI", or "archaeological" for an interval that carries
        no statistical claim at all.

        Decision D7. Without this, CQ4b compares two intervals as if their
        endpoints were hard boundaries — which is the very reduction this
        project argues against, committed by our own query. A calibrated
        radiocarbon interval is not a fact with edges: it is a hedged
        estimate, and the source says so ("the precision of the radiocarbon
        dates of medieval samples are often better than ±25 to 30 years for
        the 1 sigma statistical uncertainty").

        Consequence: a disagreement computed from bare bounds is a claim about
        the bounds, not about the individual. queries/cq04b_tolerant.rq applies
        the source's OWN stated precision and reports a different — and, as it
        turns out, more faithful — result."""@en ;
    rdfs:domain po:CalibratedInterval ;
    rdfs:range xsd:string .

ex:hackett1976 a po:Source ;
    rdfs:label "Hackett 1976, Diagnostic criteria of syphilis, yaws and treponarid"@en ;
    rdfs:comment "The source of the on-trial and diagnostic criteria the study scores its lesions against."@en .

ex:kiefferOlsen1993 a po:Source ;
    rdfs:label "Kieffer-Olsen 1993 — arm-position chronology for Danish medieval burials"@en .

ex:meth_archaeometry a po:MethodologicalClaim ;
    rdfs:label "Archaeometric analysis cannot establish the origin of the lesions"@en ;
    po:aboutTechnique ex:radiocarbon ;
    po:appliedTo ex:rf130,
        ex:sk90 ;
    po:declaredIn ex:schwarz2013 ;
    po:discriminatesBetween ex:treponematosis ;
    po:framesContent po:ModernBiomedical ;
    po:hasDiscriminatingPower po:Inconclusive ;
    po:hedge po:Certain ;
    po:hedgeWording "the results of the archaeometric analyses applied here cannot elucidate the origin of the probable treponemal bone lesions" ;
    po:heldBy ex:schwarzTeam ;
    po:underFramework po:ModernBiomedical .

ex:meth_armPosition a po:MethodologicalClaim ;
    rdfs:label "Arm-position dating is not substantiated by scientific dating methods"@en ;
    po:aboutTechnique ex:armPosition ;
    po:declaredIn ex:schwarz2013 ;
    po:framesContent po:ModernBiomedical ;
    po:hasDiscriminatingPower po:Suggestive ;
    po:hedge po:Probable ;
    po:hedgeWording "the arm position methodology has not been substantiated by scientific dating methods such as radiocarbon dating, dendrochronology or thermoluminescence" ;
    po:heldBy ex:schwarzTeam ;
    po:underFramework po:ModernBiomedical .

ex:meth_ct a po:MethodologicalClaim ;
    rdfs:label "CT cannot separate the causative agents of treponemal infection"@en ;
    po:aboutTechnique ex:ct ;
    po:declaredIn ex:schwarz2013 ;
    po:discriminatesBetween ex:treponematosis,
        ex:venerealSyphilis ;
    po:framesContent po:ModernBiomedical ;
    po:hasDiscriminatingPower po:Inconclusive ;
    po:hedge po:Certain ;
    po:hedgeWording "neither X-ray nor CT-scanning can distinguish between the different causative agents of treponemal infection" ;
    po:heldBy ex:schwarzTeam ;
    po:underFramework po:ModernBiomedical .

ex:meth_freshwater a po:MethodologicalClaim ;
    rdfs:label "No freshwater reservoir correction could be calculated, so the radiocarbon ages of Sk. 89, Sk. 94 and Refshale 130 may be too old and those individuals may postdate 1493"@en ;
    po:aboutTechnique ex:radiocarbon ;
    po:appliedTo ex:rf130,
        ex:sk89,
        ex:sk94 ;
    po:declaredIn ex:schwarz2013 ;
    po:discriminatesBetween ex:treponematosis ;
    po:framesContent po:ModernBiomedical ;
    po:hasDiscriminatingPower po:Inconclusive ;
    po:hedge po:Possible ;
    po:hedgeWording "the radiocarbon ages of all three individuals can therefore be younger than the ages quoted here, which is without a freshwater reservoir correction; it is therefore possible that all three individuals can have died after 1493" ;
    po:heldBy ex:schwarzTeam ;
    po:underFramework po:ModernBiomedical .

ex:meth_macroscopic a po:MethodologicalClaim ;
    rdfs:label "Macroscopic examination cannot separate the three treponematoses"@en ;
    po:aboutTechnique ex:macroscopic ;
    po:declaredIn ex:schwarz2013 ;
    po:discriminatesBetween ex:treponematosis,
        ex:venerealSyphilis ;
    po:framesContent po:ModernBiomedical ;
    po:hasDiscriminatingPower po:Inconclusive ;
    po:hedge po:Certain ;
    po:hedgeWording "the bone lesions of the three treponematoses affecting the skeleton are not distinguishable from each other" ;
    po:heldBy ex:schwarzTeam ;
    po:underFramework po:ModernBiomedical .

ex:meth_mercury a po:MethodologicalClaim ;
    rdfs:label "Mercury analysis is a helpful but not decisive tool"@en ;
    po:aboutTechnique ex:cvaas ;
    po:declaredIn ex:schwarz2013 ;
    po:framesContent po:ModernBiomedical ;
    po:hasDiscriminatingPower po:Suggestive ;
    po:hedge po:Probable ;
    po:hedgeWording "the Hg analysis is found to be a helpful tool when analysing skeletal remains from the medieval times for pathologies" ;
    po:heldBy ex:schwarzTeam ;
    po:underFramework po:ModernBiomedical .

ex:orbit a po:Bone ;
    rdfs:label "orbit"@en .

ex:rasmussen a foaf:Person ;
    foaf:name "Kaare Lund Rasmussen" .

ex:rf130_claim_accordance a po:MethodologicalClaim ;
    rdfs:label "The paper claims complete accordance between the two dates for Refshale 130"@en ;
    po:aboutTechnique ex:radiocarbon ;
    po:appliedTo ex:rf130 ;
    po:declaredIn ex:schwarz2013 ;
    po:framesContent po:ModernBiomedical ;
    po:hasDiscriminatingPower po:Suggestive ;
    po:hedge po:Probable ;
    po:hedgeWording "only in the case of burial 130 from Refshale is seen a complete accordance" ;
    po:heldBy ex:schwarzTeam ;
    po:underFramework po:ModernBiomedical .

ex:rf130_claim_age a po:AgeClaim ;
    rdfs:label "Age at death of Refshale 130 estimated at 24.7–46.4 years"@en ;
    po:aboutSpecimen ex:rf130 ;
    po:declaredIn ex:schwarz2013 ;
    po:framesContent po:ModernBiomedical ;
    po:groundedIn ex:rf130_obs_transition ;
    po:hedge po:Probable ;
    po:hedgeWording "transition analysis suggests an age between 24.7 to 46.4 years with a maximum likelihood of 32.9 years" ;
    po:heldBy ex:schwarzTeam ;
    po:maxAge 46 ;
    po:minAge 24 ;
    po:underFramework po:ModernBiomedical .

ex:rf130_claim_date_armPosition a po:DatingClaim ;
    rdfs:label "Archaeological date of Refshale 130 by arm position"@en ;
    po:aboutSpecimen ex:rf130 ;
    po:declaredIn ex:schwarz2013 ;
    po:framesContent po:ModernBiomedical ;
    po:groundedIn ex:rf130_obs_armPosition ;
    po:hasResult ex:rf130_interval_armPosition ;
    po:hedge po:Possible ;
    po:heldBy ex:schwarzTeam ;
    po:underFramework po:ModernBiomedical .

ex:rf130_claim_date_c14 a po:DatingClaim ;
    rdfs:label "Radiocarbon date of Refshale 130, marine-corrected (45 years, 13 % marine diet)"@en ;
    po:aboutSpecimen ex:rf130 ;
    po:appliedCorrection ex:marineCorrection ;
    po:declaredIn ex:schwarz2013 ;
    po:framesContent po:ModernBiomedical ;
    po:groundedIn ex:rf130_obs_isotopes,
        ex:rf130_obs_radiocarbon ;
    po:hasResult ex:rf130_interval_c14,
        ex:rf130_interval_c14_95 ;
    po:hedge po:Probable ;
    po:hedgeWording "the skeleton is radiocarbon dated to calAD 1160–1212 at ± 1 sigma" ;
    po:heldBy ex:schwarzTeam ;
    po:underFramework po:ModernBiomedical .

ex:rf130_claim_noMercuryTreatment a po:TreatmentClaim ;
    rdfs:label "Treatment with Hg-containing medicine DENIED for Refshale 130"@en ;
    po:aboutSpecimen ex:rf130 ;
    po:declaredIn ex:schwarz2013 ;
    po:framesContent po:MedievalHumoral ;
    po:groundedIn ex:rf130_obs_mercury ;
    po:hedge po:Probable ;
    po:hedgeWording "these individuals were not exposed to high amounts of Hg during their life, but exhibit Hg concentrations typical for the non-exposed individuals" ;
    po:heldBy ex:schwarzTeam ;
    po:isNegated true ;
    po:proposesTreatment ex:mercuryTreatment ;
    po:underFramework po:ModernBiomedical .

ex:rf130_claim_systemic a po:DiagnosticClaim ;
    rdfs:label "A systemic disease proposed for Refshale 130"@en ;
    po:aboutSpecimen ex:rf130 ;
    po:declaredIn ex:schwarz2013 ;
    po:framesContent po:ModernBiomedical ;
    po:groundedIn ex:rf130_obs_femur,
        ex:rf130_obs_fibula,
        ex:rf130_obs_humerus,
        ex:rf130_obs_radius,
        ex:rf130_obs_tibia ;
    po:hedge po:Probable ;
    po:hedgeWording "changes observed on nearly all the long bones indicate a systemic disease" ;
    po:heldBy ex:schwarzTeam ;
    po:proposesCondition ex:systemicDisease ;
    po:underFramework po:ModernBiomedical .

ex:rf130_claim_treponematosis a po:DiagnosticClaim ;
    rdfs:label "Treponemal disease entertained for Refshale 130, at a lower confidence than Sk. 90"@en ;
    po:aboutSpecimen ex:rf130 ;
    po:declaredIn ex:schwarz2013 ;
    po:framesContent po:ModernBiomedical ;
    po:groundedIn ex:rf130_obs_femur,
        ex:rf130_obs_tibia ;
    po:hedge po:Possible ;
    po:hedgeWording "lesions consistent with treponemal disease are found on several long bones, but only those in skeleton 90 from St. Albani are indicative of treponemal infection" ;
    po:heldBy ex:schwarzTeam ;
    po:proposesCondition ex:treponematosis ;
    po:underFramework po:ModernBiomedical .

ex:rf130_obs_femur_ct a po:Observation ;
    rdfs:label "CT: increased radiodensity in the right femur — described as non-specific, and possibly normal variation"@en ;
    po:declaredIn ex:schwarz2013 ;
    po:observedOn ex:rf130 ;
    po:observesLesionType ex:increasedRadiodensity ;
    po:onBone ex:femur ;
    po:usedTechnique ex:ct .

ex:rf130_obs_sex a po:Observation ;
    rdfs:label "Pelvic morphology consistent with a female individual"@en ;
    po:declaredIn ex:schwarz2013 ;
    po:observedOn ex:rf130 ;
    po:usedTechnique ex:pelvicMorphology .

ex:rf130_obs_tibia_ct a po:Observation ;
    rdfs:label "CT: osteolytic changes within the cortex of the right tibia — described as non-specific"@en ;
    po:declaredIn ex:schwarz2013 ;
    po:observedOn ex:rf130 ;
    po:observesLesionType ex:osteolyticLesion ;
    po:onBone ex:tibia ;
    po:usedTechnique ex:ct .

ex:rf130_reject_leprosy a po:RejectionClaim ;
    rdfs:label "Leprosy rejected for Refshale 130"@en ;
    cito:agreesWith ex:rf130_claim_boldsen ;
    po:aboutSpecimen ex:rf130 ;
    po:declaredIn ex:schwarz2013 ;
    po:framesContent po:ModernBiomedical ;
    po:groundedIn ex:rf130_obs_radius,
        ex:rf130_obs_tibia ;
    po:hedge po:Probable ;
    po:hedgeWording "none of the five skeletons described in this paper shows any lesions diagnostic of leprosy" ;
    po:heldBy ex:schwarzTeam ;
    po:rejects ex:rf130_claim_alt_leprosy ;
    po:underFramework po:ModernBiomedical .

ex:rf130_reject_tuberculosis a po:RejectionClaim ;
    rdfs:label "Tuberculosis rejected for Refshale 130"@en ;
    po:aboutSpecimen ex:rf130 ;
    po:declaredIn ex:schwarz2013 ;
    po:framesContent po:ModernBiomedical ;
    po:groundedIn ex:rf130_obs_femur,
        ex:rf130_obs_humerus ;
    po:hedge po:Probable ;
    po:hedgeWording "tuberculosis is usually affecting the spine and the inner table of the cranium while hypertrophic expansion of the long bones is described as unusual" ;
    po:heldBy ex:schwarzTeam ;
    po:rejects ex:rf130_claim_alt_tuberculosis ;
    po:underFramework po:ModernBiomedical .

ex:schwarz a foaf:Person ;
    foaf:name "Susanne Schwarz" .

ex:sk89_claim_age a po:AgeClaim ;
    rdfs:label "Age at death of Sk. 89 given only as adult; the bounds recorded here are the study's adult category, not a measured estimate"@en ;
    po:aboutSpecimen ex:sk89 ;
    po:declaredIn ex:schwarz2013 ;
    po:framesContent po:ModernBiomedical ;
    po:groundedIn ex:sk89_obs_tibia ;
    po:hedge po:Tentative ;
    po:hedgeWording "only the postcranial skeleton is present, which made ageing and sexing the individual difficult" ;
    po:heldBy ex:schwarzTeam ;
    po:maxAge 60 ;
    po:minAge 20 ;
    po:underFramework po:ModernBiomedical .

ex:sk89_claim_date_c14 a po:DatingClaim ;
