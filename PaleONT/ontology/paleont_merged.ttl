    po:hedgeWording "the lowest possible age was 15 years while the upper end estimate was 22.7 years at a level of 95% confidence" ;
    po:heldBy ex:schwarzTeam ;
    po:maxAge 23 ;
    po:minAge 15 ;
    po:underFramework po:ModernBiomedical .

ex:sk90_claim_date_c14 a po:DatingClaim ;
    rdfs:label "Radiocarbon date of Sk. 90, marine-corrected"@en ;
