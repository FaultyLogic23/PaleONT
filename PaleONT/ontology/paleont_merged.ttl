ex:sk90_obs_isotopes a po:Observation ;
    rdfs:label "δ13C −19.72 ‰, δ15N 8.88 ‰, C:N 3.4 — estimated marine diet 1 %"@en ;
    po:declaredIn ex:schwarz2013 ;
    po:observedOn ex:sk90 ;
    po:usedTechnique ex:irms .

ex:sk90_obs_parietal a po:Observation ;
    rdfs:label "Focal superficial cavitation and clustered pits on the right parietal"@en ;
    po:declaredIn ex:schwarz2013 ;
    po:observedOn ex:sk90 ;
    po:observesLesionType ex:clusteredPitting,
        ex:focalSuperficialCavitation ;
    po:onBone ex:parietal ;
    po:usedTechnique ex:macroscopic .

ex:sk90_obs_parietal_ct a po:Observation ;
    rdfs:label "CT: increased density of the diploë, thickening of the tables, outer table interrupted by round notches, focal radiolucent areas"@en ;
    po:declaredIn ex:schwarz2013 ;
    po:observedOn ex:sk90 ;
    po:observesLesionType ex:osteolyticLesion ;
    po:onBone ex:parietal ;
    po:usedTechnique ex:ct .

ex:sk94_obs_tibia a po:Observation ;
    rdfs:label "Bone changes of the right tibia fit Hackett's on-trial criteria of rugose nodes and expansions"@en ;
    po:declaredIn ex:schwarz2013 ;
    po:observedOn ex:sk94 ;
    po:observesLesionType ex:nodesWithStriation,
        ex:rugoseExpansion ;
    po:onBone ex:tibia ;
    po:usedTechnique ex:macroscopic .

ex:transitionAnalysis a po:Technique ;
    rdfs:label "transition analysis"@en ;
    rdfs:comment "Age-at-death estimation after Boldsen et al."@en ;
    po:hasErrorSource ex:adultAgeingError .

ex:venerealSyphilis a po:Condition ;
    rdfs:label "venereal syphilis (Treponema pallidum pallidum)"@en ;
    rdfs:comment "⚠ closeMatch until checked: MONDO:0005976 is 'Syphilis'; the paper's term is specifically VENEREAL syphilis, opposed throughout to the non-venereal treponematoses."@en ;
    skos:closeMatch <http://purl.obolibrary.org/obo/MONDO_0005976> .

po:proposes a owl:ObjectProperty ;
    rdfs:label "proposes"@en ;
    rdfs:comment "Superproperty. Never asserted directly; always inferred."@en ;
    rdfs:domain po:Claim .

po:Suggestive a po:DiscriminatingPower ;
    rdfs:label "suggestive"@en .

ex:irms a po:Technique ;
    rdfs:label "isotope-ratio mass spectrometry (IRMS)"@en ;
    rdfs:comment "δ13C and δ15N on bone collagen, Museum für Naturkunde, Berlin."@en .

ex:marineCorrection a po:Correction ;
    rdfs:label "marine reservoir correction"@en ;
    rdfs:comment "K_reservoir = 410 * (19.8 + δ13C_sample) / 8.9 14C-years (Rasmussen et al. 2008). The magnitude depends on the estimated marine diet: 4 years for Sk. 90 (1% marine), 45 years for Refshale 130 (13% marine)."@en .

ex:sk89_obs_tibia a po:Observation ;
    rdfs:label "Both tibiae display nodes with striation on the medial side of the diaphysis; the surfaces appear very uneven and rugose, with bone deposits merging into the surrounding bone with diffuse borders"@en ;
    po:declaredIn ex:schwarz2013 ;
    po:observedOn ex:sk89 ;
    po:observesLesionType ex:boneDeposits,
        ex:nodesWithStriation ;
    po:onBone ex:tibia ;
    po:usedTechnique ex:macroscopic .

ex:sk90_obs_humerus a po:Observation ;
    rdfs:label "Periosteal reactions and cortical thickening, mainly in the distal end"@en ;
    po:declaredIn ex:schwarz2013 ;
    po:observedOn ex:sk90 ;
    po:observesLesionType ex:periostealReaction ;
    po:onBone ex:humerus ;
    po:usedTechnique ex:ct .

ex:sk90_obs_tibia a po:Observation ;
    rdfs:label "Thickened cortex, diffuse changes on the anterior surface, diffuse clustered pitting"@en ;
    po:declaredIn ex:schwarz2013 ;
    po:observedOn ex:sk90 ;
    po:observesLesionType ex:clusteredPitting,
        ex:periostealReaction ;
    po:onBone ex:tibia ;
    po:usedTechnique ex:ct .

po:engagesWith a owl:ObjectProperty ;
    rdfs:label "engages with"@en ;
    rdfs:comment "Superproperty. Never asserted directly; always inferred."@en ;
    rdfs:domain po:Claim ;
    rdfs:range po:Claim .

po:DiagnosticFramework a owl:Class ;
    rdfs:label "Diagnostic framework"@en ;
    rdfs:comment """The standpoint from which a claim is made — modern
        biomedical, medieval humoral. Two individuals carry the entire
        perspectival argument: the same specimen seen through two
        incommensurable lenses."""@en .

po:DiscriminatingPower a owl:Class ;
    rdfs:label "Discriminating power"@en ;
    rdfs:comment """How far a technique is said to separate competing
        hypotheses. A small controlled list, so that 'which techniques
        cannot discriminate' is a value filter rather than a second
        question."""@en .

po:Inconclusive a po:DiscriminatingPower ;
    rdfs:label "inconclusive"@en .

ex:armPosition a po:Technique ;
    rdfs:label "arm-position dating"@en ;
    rdfs:comment "Archaeological dating from burial arm position (Kieffer-Olsen)."@en ;
    po:hasErrorSource ex:unsubstantiatedMethod .

ex:leprosy a po:Condition ;
    rdfs:label "leprosy"@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/MONDO_0005124> .

ex:mercuryTreatment a po:Treatment ;
    rdfs:label "treatment with Hg-containing medicine"@en .

ex:tp292_obs_frontal a po:Observation ;
    rdfs:label "Serpiginous cavitation on the frontal bone, continuing into the right orbit"@en ;
    po:declaredIn ex:schwarz2013 ;
    po:observedOn ex:tp292 ;
    po:observesLesionType ex:serpiginousCavitation ;
    po:onBone ex:frontal ;
    po:usedTechnique ex:macroscopic .

ex:tuberculosis a po:Condition ;
    rdfs:label "tuberculosis"@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/MONDO_0018076> .

po:MedievalHumoral a po:DiagnosticFramework ;
    rdfs:label "medieval humoral framework"@en .

ex:cvaas a po:Technique ;
    rdfs:label "cold vapour atomic absorption spectroscopy (CV-AAS)"@en ;
    rdfs:comment "Flow Injection Mercury System 400, PerkinElmer."@en .

ex:osteolyticLesion a po:LesionType ;
    rdfs:label "osteolytic lesion"@en .

ex:periostealReaction a po:LesionType ;
    rdfs:label "periosteal reaction with cortical thickening"@en .

po:TreatmentClaim a owl:Class ;
    rdfs:label "Treatment claim"@en ;
    rdfs:comment """Proposes a treatment received in life. Typically made
        under a historical framework, and typically grounded in a chemical
        observation such as mercury."""@en ;
    rdfs:subClassOf po:Claim .

ex:femur a po:Bone ;
    rdfs:label "femur"@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/UBERON_0000981> .

ex:radiocarbon a po:Technique ;
    rdfs:label "radiocarbon dating"@en ;
    rdfs:comment "Leibniz Laboratory, Kiel. Calibrated with OxCal v4.1.7 and IntCal09."@en ;
    po:hasErrorSource ex:countingUncertainty,
        ex:freshwaterReservoir,
        ex:marineReservoir .

po:AgeClaim a owl:Class ;
    rdfs:label "Age claim"@en ;
    rdfs:comment """Proposes an age-at-death range. Age is a claim, not a
        property of the specimen — deliberately the same shape as a
        diagnosis."""@en ;
    rdfs:subClassOf po:Claim .

po:ConfidenceLevel a owl:Class ;
    rdfs:label "Confidence level"@en ;
    rdfs:comment """The hedge attached to a claim, as an individual rather
        than a string or a number. A number would invent precision the source
        never produced; a string cannot be counted, grouped or ordered."""@en .

po:ErrorSource a owl:Class ;
    rdfs:label "Error source"@en ;
    rdfs:comment """A known limitation of a technique — e.g. the marine
        reservoir effect. A property of the TECHNIQUE: it holds always.
        Contrast po:Correction."""@en .

po:Source a owl:Class ;
    rdfs:label "Source"@en ;
    rdfs:comment "A publication in which claims are declared."@en .

po:Certain a po:ConfidenceLevel ;
    rdfs:label "certain"@en .

ex:tibia a po:Bone ;
    rdfs:label "tibia"@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/UBERON_0000979> .

po:Specimen a owl:Class ;
    rdfs:label "Specimen"@en ;
    rdfs:comment """A set of skeletal remains attributed to one individual.
        The anchor of the graph. Deliberately poor in properties: almost
        nothing is said ABOUT a specimen, because almost everything one might
        want to say is in fact a claim someone made."""@en .

po:Bone a owl:Class ;
    rdfs:label "Bone"@en ;
    rdfs:comment """Skeletal element. Individuals carry skos:exactMatch links
        to UBERON rather than using UBERON classes directly as values, which
        avoids punning."""@en .

po:DatingClaim a owl:Class ;
    rdfs:label "Dating claim"@en ;
    rdfs:comment "Proposes a calibrated interval for a specimen."@en ;
    rdfs:subClassOf po:Claim .

ex:ct a po:Technique ;
    rdfs:label "computed tomography (CT) scanning"@en ;
    rdfs:comment "SOMATOM Sensation 64 (Kiel) and SOMATOM Spirit (Odense), Siemens."@en .

ex:treponematosis a po:Condition ;
    rdfs:label "treponemal infection (treponematosis)"@en ;
    rdfs:comment "MONDO:0007000 'Treponema infectious disease' — the family covering syphilis, yaws, bejel and pinta, which is the sense the paper uses."@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/MONDO_0007000> .

po:MethodologicalClaim a owl:Class ;
    rdfs:label "Methodological claim"@en ;
    rdfs:comment """A claim about what a technique can or cannot establish.
        The meta level. Note that it has NO po:aboutSpecimen: its subject
        matter is a technique, not a skeleton. That absence is how the model
        distinguishes 'this individual had leprosy' from 'this method cannot
        tell leprosy from syphilis'."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty po:aboutSpecimen ],
        po:Claim .

po:Technique a owl:Class ;
    rdfs:label "Technique"@en ;
    rdfs:comment """Any means by which an observation is produced: naked-eye
        examination, radiography, radiocarbon dating, atomic absorption
        spectrometry. ONE class, no hierarchy. Ranking techniques by
        reliability is what the sources ARGUE about, so it must live in
        po:MethodologicalClaim, never in the schema."""@en .

po:Condition a owl:Class ;
    rdfs:label "Condition"@en ;
    rdfs:comment """A disease or pathological condition. Individuals carry
        skos:exactMatch links to MONDO. NOTE: there is no path from
        po:Specimen to this class."""@en .

ex:macroscopic a po:Technique ;
    rdfs:label "macroscopic examination"@en .

po:LesionType a owl:Class ;
    rdfs:label "Lesion type"@en ;
    rdfs:comment """The type of a skeletal lesion, shared across specimens.
        The concrete occurrence is the po:Observation. This split is what
        makes CQ10 (recurrence across specimens) answerable."""@en .

ex:sk89 a po:Specimen ;
    rdfs:label "St. Albani, Skeleton 89"@en ;
    rdfs:comment "Burial 89, St. Albani churchyard, Odense (Funen). Urban site. Postcranial skeleton only, which made ageing and sexing difficult; most likely an adult female."@en ;
    po:specimenID "St. Albani-89" .

ex:tp292 a po:Specimen ;
    rdfs:label "Tirup, Skeleton 292"@en ;
    rdfs:comment "Burial 292, Tirup cemetery, near Horsens (Jutland). Rural site. Female, early adult. One of only 79 individuals examined at Tirup and the only one selected for this study."@en ;
    po:specimenID "Tirup-292" .

po:CalibratedInterval a owl:Class ;
    rdfs:label "Calibrated interval"@en ;
    rdfs:comment """A dated range with numeric bounds. A class rather than a
        literal because CQ4b must COMPUTE disagreement by comparing two
        intervals, which a label cannot support."""@en .

po:RejectionClaim a owl:Class ;
    rdfs:label "Rejection claim"@en ;
    rdfs:comment """Rejects another claim. Note the range of po:rejects: a
        rejection is an act against an ASSERTION, never a verdict on the
        truth of a disease. Acquittal is not innocence."""@en ;
    rdfs:subClassOf po:Claim .

po:Claim a owl:Class ;
    rdfs:label "Claim"@en ;
    rdfs:comment """A proposition held by an agent, under a framework, with a
        stated degree of confidence, grounded in one or more observations.
        Nothing enters this graph as fact; everything enters as something
        someone asserted."""@en .

ex:sk94 a po:Specimen ;
    rdfs:label "St. Albani, Skeleton 94"@en ;
    rdfs:comment "Burial 94, St. Albani churchyard, Odense (Funen). Urban site. Male, mid-adult."@en ;
    po:specimenID "St. Albani-94" .

ex:rf130 a po:Specimen ;
    rdfs:label "Refshale, Skeleton 130"@en ;
    rdfs:comment "Burial 130, Refshale graveyard, Maribo district, Lolland. Rural site. Completely preserved adult female."@en ;
    po:specimenID "Refshale-130" .

po:Possible a po:ConfidenceLevel ;
    rdfs:label "possible"@en ;
    po:weakerThan po:Probable .

po:DiagnosticClaim a owl:Class ;
    rdfs:label "Diagnostic claim"@en ;
    rdfs:comment "Proposes a condition for a specimen."@en ;
    rdfs:subClassOf po:Claim .

po:Probable a po:ConfidenceLevel ;
    rdfs:label "probable"@en ;
    po:weakerThan po:Certain .

ex:sk90 a po:Specimen ;
    rdfs:label "St. Albani, Skeleton 90"@en ;
    rdfs:comment "Burial 90, St. Albani churchyard, Odense (Funen), urban site. Male, good state of preservation."@en ;
    po:specimenID "St. Albani-90" .

po:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:comment """One act of examining a specimen with a technique, yielding
        one datum. Carries what was seen, on which bone, by which technique.
        This is the concrete occurrence: the lesion TYPE is shared across
        specimens, the observation is not."""@en .

ex:schwarzTeam a foaf:Organization ;
    rdfs:comment "Holder of the claims the present study makes collectively, so that individual attribution is never invented."@en ;
    foaf:name "Schwarz, Skytte & Rasmussen (2013 study team)" .

ex:schwarz2013 a po:Source ;
    rdfs:label "Schwarz, Skytte & Rasmussen 2013, Heritage Science 1:19"@en ;
    dcterms:identifier "doi:10.1186/2050-7445-1-19" ;
    dcterms:title "Pre-Columbian treponemal infection in Denmark? — a paleopathological and archaeometric approach"@en .

po:ModernBiomedical a po:DiagnosticFramework ;
    rdfs:label "modern biomedical framework"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( po:DiagnosticClaim po:RejectionClaim po:DatingClaim po:AgeClaim po:TreatmentClaim po:MethodologicalClaim ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( po:Certain po:Probable po:Possible po:Tentative ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( po:Discriminating po:Suggestive po:Inconclusive ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( po:ModernBiomedical po:MedievalHumoral ) .

[] a owl:AllDisjointClasses ;
    owl:members ( po:Specimen po:Observation po:Claim po:CalibratedInterval po:Technique po:LesionType po:Bone po:Condition po:DiagnosticFramework po:ConfidenceLevel po:Source po:ErrorSource po:Correction po:Treatment po:DiscriminatingPower ) .

