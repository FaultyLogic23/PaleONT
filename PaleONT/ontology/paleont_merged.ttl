    po:hedgeWording "only those in skeleton 90 from St. Albani are indicative of treponemal infection" ;
    po:heldBy ex:schwarzTeam ;
    po:proposesCondition ex:treponematosis ;
    po:underFramework po:ModernBiomedical .

ex:sk90_interval_c14_uncorrected a po:CalibratedInterval ;
    rdfs:label "calAD 1435–1488, 95% CI, uncorrected for marine signature"@en ;
    po:confidenceInterval "95% CI, uncorrected for marine signature" ;
    po:endYear 1488 ;
    po:startYear 1435 .

ex:sk90_obs_pelvis a po:Observation ;
    rdfs:label "Pelvic morphology and general robust appearance of the skeletal elements"@en ;
    po:declaredIn ex:schwarz2013 ;
    po:observedOn ex:sk90 ;
    po:usedTechnique ex:macroscopic .

ex:sk90_reject_armPositionDate a po:RejectionClaim ;
    rdfs:label "The arm-position date for Sk. 90 is rejected in favour of the radiocarbon date"@en ;
    po:aboutSpecimen ex:sk90 ;
    po:declaredIn ex:schwarz2013 ;
    po:framesContent po:ModernBiomedical ;
    po:groundedIn ex:sk90_obs_isotopes ;
    po:hedge po:Probable ;
    po:hedgeWording "this fact points to an error in the archaeological date by arm position (AD 1250–1400) as compared to reliable radiocarbon date of calAD 1443–1466" ;
    po:heldBy ex:schwarzTeam ;
    po:rejects ex:sk90_claim_date_armPosition ;
    po:underFramework po:ModernBiomedical .

ex:sk90_reject_fungal a po:RejectionClaim ;
    rdfs:label "Fungal infection rejected"@en ;
