@prefix cito: <http://purl.org/spar/cito/> .
@prefix ex: <https://w3id.org/paleont/data/> .
@prefix po: <https://w3id.org/paleont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:meth_archaeometry a po:MethodologicalClaim ;
    rdfs:label "Archaeometric analysis cannot establish the origin of the lesions"@en ;
    po:aboutTechnique ex:radiocarbon ;
    po:appliedTo ex:rf130,
        ex:sk90 ;
    po:declaredIn ex:schwarz2013 ;
    po:discriminatesBetween ex:treponematosis ;
    po:framesContent po:ModernBiomedical ;
    po:hasDiscriminatingPower po:Inconclusive ;
    po:hedge po:Certain ;
    po:hedgeWording "the results of the archaeometric analyses applied here cannot elucidate the origin of the probable treponemal bone lesions" ;
    po:heldBy ex:schwarzTeam ;
    po:underFramework po:ModernBiomedical .

ex:meth_armPosition a po:MethodologicalClaim ;
    rdfs:label "Arm-position dating is not substantiated by scientific dating methods"@en ;
    po:aboutTechnique ex:armPosition ;
    po:declaredIn ex:schwarz2013 ;
    po:framesContent po:ModernBiomedical ;
    po:hasDiscriminatingPower po:Suggestive ;
    po:hedge po:Probable ;
    po:hedgeWording "the arm position methodology has not been substantiated by scientific dating methods such as radiocarbon dating, dendrochronology or thermoluminescence" ;
    po:heldBy ex:schwarzTeam ;
    po:underFramework po:ModernBiomedical .

ex:meth_ct a po:MethodologicalClaim ;
    rdfs:label "CT cannot separate the causative agents of treponemal infection"@en ;
    po:aboutTechnique ex:ct ;
    po:declaredIn ex:schwarz2013 ;
    po:discriminatesBetween ex:treponematosis,
        ex:venerealSyphilis ;
    po:framesContent po:ModernBiomedical ;
    po:hasDiscriminatingPower po:Inconclusive ;
    po:hedge po:Certain ;
    po:hedgeWording "neither X-ray nor CT-scanning can distinguish between the different causative agents of treponemal infection" ;
    po:heldBy ex:schwarzTeam ;
    po:underFramework po:ModernBiomedical .

ex:meth_freshwater a po:MethodologicalClaim ;
    rdfs:label "No freshwater reservoir correction could be calculated, so the radiocarbon ages of Sk. 89, Sk. 94 and Refshale 130 may be too old and those individuals may postdate 1493"@en ;
    po:aboutTechnique ex:radiocarbon ;
    po:appliedTo ex:rf130,
        ex:sk89,
        ex:sk94 ;
    po:declaredIn ex:schwarz2013 ;
    po:discriminatesBetween ex:treponematosis ;
    po:framesContent po:ModernBiomedical ;
    po:hasDiscriminatingPower po:Inconclusive ;
    po:hedge po:Possible ;
    po:hedgeWording "the radiocarbon ages of all three individuals can therefore be younger than the ages quoted here, which is without a freshwater reservoir correction; it is therefore possible that all three individuals can have died after 1493" ;
    po:heldBy ex:schwarzTeam ;
    po:underFramework po:ModernBiomedical .

ex:meth_macroscopic a po:MethodologicalClaim ;
    rdfs:label "Macroscopic examination cannot separate the three treponematoses"@en ;
    po:aboutTechnique ex:macroscopic ;
    po:declaredIn ex:schwarz2013 ;
    po:discriminatesBetween ex:treponematosis,
        ex:venerealSyphilis ;
    po:framesContent po:ModernBiomedical ;
    po:hasDiscriminatingPower po:Inconclusive ;
    po:hedge po:Certain ;
    po:hedgeWording "the bone lesions of the three treponematoses affecting the skeleton are not distinguishable from each other" ;
    po:heldBy ex:schwarzTeam ;
    po:underFramework po:ModernBiomedical .

ex:meth_mercury a po:MethodologicalClaim ;
    rdfs:label "Mercury analysis is a helpful but not decisive tool"@en ;
    po:aboutTechnique ex:cvaas ;
    po:declaredIn ex:schwarz2013 ;
    po:framesContent po:ModernBiomedical ;
    po:hasDiscriminatingPower po:Suggestive ;
    po:hedge po:Probable ;
    po:hedgeWording "the Hg analysis is found to be a helpful tool when analysing skeletal remains from the medieval times for pathologies" ;
    po:heldBy ex:schwarzTeam ;
    po:underFramework po:ModernBiomedical .

